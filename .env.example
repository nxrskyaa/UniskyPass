# Public frontend configuration. Safe to expose in the browser.
NEXT_PUBLIC_MONAD_RPC_URL=https://rpc.monad.xyz
NEXT_PUBLIC_MONAD_CHAIN_ID=143
NEXT_PUBLIC_UNISKY_PASS_CONTRACT_ADDRESS=
NEXT_PUBLIC_BLOCK_EXPLORER_URL=https://monadscan.com

# Foundry deployment only. Never prefix this with NEXT_PUBLIC_.
# Keep the real value only in the human deployer's current shell/process.
# Never put it in .env.local, Vercel, or any NEXT_PUBLIC_ variable.
DEPLOYER_PRIVATE_KEY=
