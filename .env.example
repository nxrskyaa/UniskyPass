# Public frontend configuration. Safe to expose in the browser.
# This only controls the initial selection; users can switch at runtime.
NEXT_PUBLIC_DEFAULT_MONAD_CHAIN_ID=143

# Privy browser configuration. The App ID and optional Client ID are public
# identifiers, not secrets. Never add a Privy App Secret or authorization key
# to this client-only project or any NEXT_PUBLIC_ variable.
NEXT_PUBLIC_PRIVY_APP_ID=cmrojn0js00bg0djs58eirybr
NEXT_PUBLIC_PRIVY_CLIENT_ID=

# Mainnet deployment (chain ID 143).
NEXT_PUBLIC_MONAD_MAINNET_RPC_URL=https://rpc.monad.xyz
NEXT_PUBLIC_MONAD_MAINNET_EXPLORER_URL=https://monadscan.com
NEXT_PUBLIC_UNISKY_PASS_MAINNET_CONTRACT_ADDRESS=0x634659d15A5a98D59ff06e9Eb7deC08bD5894fF5

# Testnet deployment (chain ID 10143).
NEXT_PUBLIC_MONAD_TESTNET_RPC_URL=https://testnet-rpc.monad.xyz
NEXT_PUBLIC_MONAD_TESTNET_EXPLORER_URL=https://testnet.monadscan.com
NEXT_PUBLIC_UNISKY_PASS_TESTNET_CONTRACT_ADDRESS=0x56e47d0233b9eAa2f6701Bb90DFD6352000D5e26

# Foundry deployment only. Never prefix this with NEXT_PUBLIC_.
# Keep the real value only in the human deployer's current shell/process.
# Never put it in .env.local, Vercel, or any NEXT_PUBLIC_ variable.
DEPLOYER_PRIVATE_KEY=
